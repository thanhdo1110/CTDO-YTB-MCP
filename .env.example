# Optional: One or multiple YouTube Data API v3 keys (auto-rotates on quota exhaustion)
# Works 100% WITHOUT any API key via built-in 2026 InnerTube Engine!
YOUTUBE_API_KEY=
YOUTUBE_API_KEYS=

# Optional: Google OAuth 2.0 Desktop Client (for YouTube Studio Analytics, SEO updates, Banner/Thumbnails & Uploads)
# Run `ctdo-ytb-mcp login --client-secret=/path/to/client_secret.json` once to save refresh_token to ~/.ctdo-ytb-mcp/account.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CTDO_MY_CHANNEL=

# Optional: TubeLab API Key (bridges paid TubeLab endpoints if provided; otherwise runs built-in free Outlier & Format Engine)
TUBELAB_API_KEY=

# Optional: Semantic Vector Embedding API Key (enables hybrid BM25 + Dense Cosine Vector search in Knowledge Base)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Tool Schema Weight Mode:
#   compact (default) = 12 ultra-lean power tools (~85% fewer context tokens, 100% feature coverage)
#   lite              = 4 core tools (<600 context tokens for small local LLMs)
#   full              = 12 power tools + 28 explicit aliases (TubeLab, Zubeid, Kirbah, IA-Programming)
CTDO_TOOL_MODE=compact

# Default output format: compact | markdown | json
CTDO_OUTPUT_FORMAT=compact

# Default language & region
CTDO_DEFAULT_LANG=en
CTDO_DEFAULT_REGION=US

# Persistent SQLite Cache & Knowledge Base directory (defaults to ~/.ctdo-ytb-mcp)
CTDO_DATA_DIR=

# Transport: stdio (default) | http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8088
MCP_STATELESS=true
